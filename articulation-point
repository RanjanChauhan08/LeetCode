class Solution {
    static int timer=1;
    static void dfs(ArrayList<ArrayList<Integer>>adj,int node,int parent,HashSet<Integer>set,int[]visited,int[]time,int []low){
        visited[node]=1;
        time[node]=timer;
        low[node]=timer;
        timer++;
        int child=0;
        for(int i=0;i<adj.get(node).size();i++){
            int newNode=adj.get(node).get(i);
            if(visited[newNode]==0){
                child++;
                dfs(adj,newNode,node,set,visited,time,low);
                low[node]=Math.min(low[node],low[newNode]);
                if(low[newNode]>=time[node] && parent!=-1){
                    set.add(node);
                }
            }
            else if(visited[newNode]==1 && newNode!=parent){
                low[node]=Math.min(low[node],time[newNode]);
            }
        }
        if(parent==-1 && child>1){
            set.add(node);
        }
    }
    static ArrayList<Integer> articulationPoints(int V, int[][] edges) {
        ArrayList<Integer>ans=new ArrayList<>();
        HashSet<Integer>set=new HashSet<>();
        ArrayList<ArrayList<Integer>>adj=new ArrayList<>();
        for(int i=0;i<V;i++)adj.add(new ArrayList<>());
        for(int i=0;i<edges.length;i++){
            int u=edges[i][0];
            int v=edges[i][1];
            adj.get(u).add(v);
            adj.get(v).add(u);
        }
        int[]visited=new int[V];
        int[]time=new int[V];
        int[]low=new int[V];
        for(int i=0;i<V;i++){
            if(visited[i]==0){
                dfs(adj,i,-1,set,visited,time,low);
            }
        }
        for(Integer i:set)ans.add(i);
        if(ans.size()==0){
            ans.add(-1);
        }
        return ans;
    }
}
