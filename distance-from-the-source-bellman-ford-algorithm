class Solution {
    public ArrayList<Integer> bellmanFord(int V, int[][] edges, int src) {
        ArrayList<Integer>ans=new ArrayList<>();
        for(int i=0;i<V;i++)ans.add(100000000);
        ans.set(src,0);
        for(int j=0;j<V-1;j++){
            for(int i=0;i<edges.length;i++){
                int u=edges[i][0];
                int v=edges[i][1];
                int d=edges[i][2];
                if(ans.get(u)==100000000)continue;
                if(ans.get(u)+d<ans.get(v)){
                    ans.set(v,(ans.get(u)+d));
                }
            }
        }
        for(int i=0;i<edges.length;i++){
            int u=edges[i][0];
            int v=edges[i][1];
            int d=edges[i][2];
            if(ans.get(u) != 100000000 && ans.get(u)+d < ans.get(v)) {
                ArrayList<Integer>a=new ArrayList<>();
                a.add(-1);
                return a;
            }
        }
        return ans;
    }
}
