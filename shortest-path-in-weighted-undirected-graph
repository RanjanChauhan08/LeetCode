class pair{
    int node;
    int dist;
    pair(int node,int dist){
        this.node=node;
        this.dist=dist;
    }
}
class Solution {
    public ArrayList<Integer> shortestPath(int V, int[][] edges, int src, int dest) {
        ArrayList<Integer>ans=new ArrayList<>();
        PriorityQueue<pair> set = new PriorityQueue<>((a, b) -> {
            if (a.dist != b.dist)
                return Integer.compare(a.dist, b.dist);
            return Integer.compare(a.node, b.node);
        });
        ArrayList<ArrayList<pair>>adj=new ArrayList<>();
        for(int i=0;i<V+1;i++)adj.add(new ArrayList<>());
        for(int i=0;i<edges.length;i++){
            int u=edges[i][0];
            int v=edges[i][1];
            int d=edges[i][2];
            adj.get(u).add(new pair(v,d));
            adj.get(v).add(new pair(u,d));
        }
        int[]dis=new int[V+1];
        for(int i=0;i<V+1;i++)dis[i]=10000000;
        dis[dest] = 0;
        set.add(new pair(dest, 0));
        int[]parent=new int[V+1];
        for(int i=0;i<V+1;i++)parent[i]=i;
        while(!set.isEmpty()){
            pair p = set.poll();
            int node = p.node;
            int dist = p.dist;
            if (dist > dis[node]) continue;
            for(int j = 0; j < adj.get(node).size(); j++){
                pair newp = adj.get(node).get(j);
                int newNode = newp.node;
                int newDist = newp.dist;

                if(dis[newNode] > dist + newDist){
                    dis[newNode] = dist + newDist;
                    parent[newNode] = node;
                    set.add(new pair(newNode, dis[newNode]));
                }
            }
        }
        if (dis[src] == 10000000)
            return new ArrayList<>(Arrays.asList(-1));

        int u = src;
        ans.add(u);

        while (u != dest) {
            adj.get(u).sort((a, b) ->
                Integer.compare(a.node, b.node));

            for (pair p : adj.get(u)) {
                int v = p.node;
                int w = p.dist;

                if (dis[v] != 10000000 &&
                    (long) w + dis[v] == dis[u]) {
                    u = v;
                    ans.add(u);
                    break;
                }
            }
        }

        return ans;
    }
}
