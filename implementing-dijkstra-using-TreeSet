class pair{
    int node;
    int dist;
    pair(int node,int dist){
        this.node=node;
        this.dist=dist;
    }
}
class Solution {
    public ArrayList<Integer> dijkstra(ArrayList<ArrayList<ArrayList<Integer>>>adj,int src) {
        TreeSet<pair> set = new TreeSet<>((a, b) -> {
            if (a.dist != b.dist)
                return Integer.compare(a.dist, b.dist);
            else
                return Integer.compare(a.node, b.node);
        });
        set.add(new pair(src,0));
        int[]dist=new int[adj.size()];
        for(int i=0;i<dist.length;i++)dist[i]=10000000;
        dist[src]=0;
        while(!set.isEmpty()){
            int len=set.size();
            for(int i=0;i<len;i++){
                pair p= set.first();
                set.remove(p);
                int node=p.node;
                int dis=p.dist;
                for(int j=0;j<adj.get(node).size();j++){
                    int newNode=adj.get(node).get(j).get(0);
                    int gap=adj.get(node).get(j).get(1);
                    if(dist[newNode]>gap+dis){
                        if(dist[newNode]!=10000000){
                            pair newpair=new pair(newNode,dist[newNode]);
                            set.remove(newpair);
                        }
                        dist[newNode]=gap+dis;
                        set.add(new pair(newNode,dist[newNode]));
                    }
                }
            }
        }
        ArrayList<Integer>ans=new ArrayList<>();
        for(int i=0;i<dist.length;i++){
            if(dist[i]==10000000){
                ans.add(-1);
            }
            else ans.add(dist[i]);
        }
        return ans;
    }
}
