class pair{
    int r;
    int c;
    pair(int r,int c){
        this.r=r;
        this.c=c;
    }
}
class Solution {
    public String helper(char[][]grid,int[][]visited,int a,int b){
        visited[a][b]=1;
        int[]dr={0,1,0,-1};
        int[]dc={-1,0,1,0};
        StringBuilder miniAns=new StringBuilder();
        Queue<pair>queue=new LinkedList<>();
        queue.add(new pair(a,b));
        while(!queue.isEmpty()){
            int len=queue.size();
            for(int i=0;i<len;i++){
                pair p=queue.poll();
                miniAns.append(p.r - a)
                               .append(",")
                               .append(p.c - b)
                               .append(";");
                for(int j=0;j<4;j++){
                    int nr=dr[j]+p.r;
                    int nc=dc[j]+p.c;
                    if(nr<0 || nr>=grid.length || nc<0 || nc>=grid[0].length || grid[nr][nc]=='W' || visited[nr][nc]==1)continue;
                    visited[nr][nc]=1;
                    queue.add(new pair(nr,nc));
                }
            }
        }
        return miniAns.toString();
    }
    public int countDistinctIslands(char[][] grid) {
        HashSet<String>ls=new HashSet<>();
        int[][]visited=new int[grid.length][grid[0].length];
        for(int i=0;i<grid.length;i++){
            for(int j=0;j<grid[0].length;j++){
                if(visited[i][j]==0 && grid[i][j]=='L'){
                    String miniAns=helper(grid,visited,i,j);
                    ls.add(miniAns);
                }
            }
        }
        return ls.size();
    }
}
