class pair{
    int node;
    int steps;
    pair(int node,int steps){
        this.node=node;
        this.steps=steps;
    }
}
class Solution {
    public int minSteps(int[] arr, int start, int end) {
        int[]dist=new int[1000];
        for(int i=0;i<dist.length;i++)dist[i]=10000000;
        dist[start]=0;
        Queue<pair>queue=new LinkedList<>();
        queue.add(new pair(start,0));
        while(!queue.isEmpty()){
            pair p=queue.poll();
            int node=p.node;
            int steps=p.steps;
            for(int i=0;i<arr.length;i++){
                int newNode=(node*arr[i])%1000;
                int newSteps=steps+1;
                if(dist[newNode]>newSteps){
                    dist[newNode]=newSteps;
                    queue.add(new pair(newNode,newSteps));
                }
            }
        }
        if(dist[end]==10000000)return -1;
        return dist[end];
    }
}
