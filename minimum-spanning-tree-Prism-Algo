class pair{
    int wt;
    int node;
    int parent;
    pair(int wt,int node,int parent){
        this.wt=wt;
        this.node=node;
        this.parent=parent;
    }
}
class Solution {
    public int primMST(ArrayList<ArrayList<ArrayList<Integer>>> adj) {
        int ans=0;
        int[]visited=new int[adj.size()];
        PriorityQueue<pair>pq=new PriorityQueue<>((a,b)->{
            if(a.wt!=b.wt)return Integer.compare(a.wt,b.wt);
            else if(a.node!=b.node)return Integer.compare(a.node,b.node);
            return Integer.compare(a.parent,b.parent);
        });
        pq.add(new pair(0,0,-1));
        while(!pq.isEmpty()){
            pair p=pq.poll();
            int node=p.node;
            if(visited[node]==1)continue;
            int wt=p.wt;
            ans+=wt;
            int parent=p.parent;
            visited[node]=1;
            for(int i=0;i<adj.get(node).size();i++){
                int newNode=adj.get(node).get(i).get(0);
                int newWt=adj.get(node).get(i).get(1);
                if(visited[newNode]==1)continue;
                pq.add(new pair(newWt,newNode,node));
            }
        }
        return ans;
    }
}
