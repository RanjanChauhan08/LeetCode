class pair{
    int node;
    int dist;
    pair(int node,int dist){
        this.node=node;
        this.dist=dist;
    }
}
class Solution {
    public ArrayList<Integer> dijkstra(ArrayList<ArrayList<ArrayList<Integer>>>adj,int src) {
        PriorityQueue<pair>queue=new PriorityQueue<>((a,b)->{
            if(a.dist!=b.dist)return a.dist-b.dist;
            else return a.node-b.dist;
        });
        queue.add(new pair(src,0));
        int[]dist=new int[adj.size()];
        for(int i=0;i<dist.length;i++)dist[i]=10000000;
        dist[src]=0;
        while(!queue.isEmpty()){
            int len=queue.size();
            for(int i=0;i<len;i++){
                pair p=queue.poll();
                int node=p.node;
                int dis=p.dist;
                for(int j=0;j<adj.get(node).size();j++){
                    int newNode=adj.get(node).get(j).get(0);
                    int gap=adj.get(node).get(j).get(1);
                    if(dist[newNode]>gap+dis){
                        dist[newNode]=gap+dis;
                        queue.add(new pair(newNode,dist[newNode]));
                    }
                }
            }
        }
        ArrayList<Integer>ans=new ArrayList<>();
        for(int i=0;i<dist.length;i++){
            if(dist[i]==10000000){
                ans.add(-1);
            }
            else ans.add(dist[i]);
        }
        return ans;
    }
}
