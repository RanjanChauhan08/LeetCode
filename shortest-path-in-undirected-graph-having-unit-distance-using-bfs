class pair{
    int node;
    int dist;
    pair(int node,int dist){
        this.node=node;
        this.dist=dist;
    }
}
class Solution {
    public int shortestPath(int V, int[][] edges, int src, int dest) {
        int[]visited=new int[V];
        ArrayList<ArrayList<Integer>>adj=new ArrayList<>();
        for(int i=0;i<V;i++)adj.add(new ArrayList<>());
        for(int i=0;i<edges.length;i++){
            int u=edges[i][0];
            int v=edges[i][1];
            adj.get(u).add(v);
            adj.get(v).add(u);
        }
        Queue<pair>queue=new LinkedList<>();
        queue.add(new pair(src,0));
        visited[src]=1;
        while(!queue.isEmpty()){
            int len=queue.size();
            for(int i=0;i<len;i++){
                pair p=queue.poll();
                int node=p.node;
                int dist=p.dist;
                if(node==dest)return dist;
                for(int j=0;j<adj.get(node).size();j++){
                    int b=adj.get(node).get(j);
                    if(visited[b]==0){
                        visited[b]=1;
                        queue.add(new pair(b,dist+1));
                    }
                }
            }
        }
        return -1;
    }
}
