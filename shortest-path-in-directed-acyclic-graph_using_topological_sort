class pair{
    int node;
    int dist;
    pair(int node,int dist){
        this.node=node;
        this.dist=dist;
    }
}
class Solution {
    public void dfs(Stack<Integer>st,ArrayList<ArrayList<pair>>adj,int[]visited,int a){
        visited[a]=1;
        for(int i=0;i<adj.get(a).size();i++){
            pair p=adj.get(a).get(i);
            if(visited[p.node]==0){
                dfs(st,adj,visited,p.node);
            }
        }
        st.push(a);
    }
    public ArrayList<Integer> shortestPath(int V, int[][] edges) {
        ArrayList<ArrayList<pair>>adj=new ArrayList<>();
        for(int i=0;i<V;i++)adj.add(new ArrayList<>());
        for(int i=0;i<edges.length;i++){
            adj.get(edges[i][0]).add(new pair(edges[i][1],edges[i][2]));
        }
        Stack<Integer>st=new Stack<>();
        int[]visited=new int[V];
        for(int i=0;i<V;i++){
            if(visited[i]==0){
                dfs(st,adj,visited,i);
            }
        }
        int[]dist=new int[V];
        for(int i=0;i<V;i++)dist[i]=100000000;
        dist[0]=0;
        while(!st.isEmpty()){
            int a=st.pop();
            for(int i=0;i<adj.get(a).size();i++){
                pair p=adj.get(a).get(i);
                int node=p.node;
                int dis=p.dist;
                if(dist[node]>dis+dist[a]){
                    dist[node]=dis+dist[a];
                }
            }
        }
        ArrayList<Integer>ans=new ArrayList<>();
        for(int i=0;i<V;i++){
            if(dist[i]==100000000)ans.add(-1);
            else ans.add(dist[i]);
        }
        return ans;
    }
}
