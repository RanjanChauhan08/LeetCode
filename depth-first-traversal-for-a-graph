class Solution {
    public void dfs(ArrayList<Integer>ans,ArrayList<ArrayList<Integer>> adj,int a,int[]visited){
        visited[a]=1;
        ans.add(a);
        for(int i=0;i<adj.get(a).size();i++){
            int b=adj.get(a).get(i);
            if(visited[b]==0){
                dfs(ans,adj,b,visited);
            }
        }
    }
    public ArrayList<Integer> dfs(ArrayList<ArrayList<Integer>> adj) {
        ArrayList<Integer>ans=new ArrayList<>();
        int[]visited=new int[adj.size()];
        for(int i=0;i<adj.size();i++){
            if(visited[i]==0){
                dfs(ans,adj,i,visited);
            }
        }
        return ans;
    }
}
